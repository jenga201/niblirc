# Copy to .env and set real values. Never commit .env.
# In the shared-env layout the project .env is a symlink to the parent
# NIBL/.env, created by NIBL/scripts/link-env.sh.

# ============================================================================
# Required
# ============================================================================

# IRC bot identity and connection.
IRC_BOT_NAME=dockerizedBot
IRC_SERVER=irc.rizon.net
IRC_PORT=9999

# DCC port range (must match the ports published in docker-compose.yml).
IRC_DCC_PORTS=46571,46572,46573

# Shared DB user/password (see the SQL_* keys in the combined NIBL/.env.example).
SQL_USER=ooinuza
SQL_PASSWORD=change-me

# ============================================================================
# Optional (defaults shown)
# ============================================================================

# Nickserv password. Leave empty if the bot does not register with NickServ.
IRC_BOT_PASS=

# DCC public address. When blank (the default), the bot resolves it at startup
# from https://ifconfig.me/ip — this is usually what you want.
#IRC_PUBLIC_IP=

# Database backend selector (mysql).
IRC_DB=mysql

# Shared DB connection values (host, port, database name).
SQL_HOST=niblmysql
SQL_PORT=3306
SQL_DATABASE=ooinuza
